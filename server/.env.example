# Copy to server/.env (gitignored) and fill in. Never commit secrets.

# Modpack source:
#  - local build:  /modpacks/<file>.mrpack  (`task server:up` fills this in with the newest build)
#  - published:    a Modrinth project slug (then also consider MODRINTH_VERSION)
# MODRINTH_MODPACK=/modpacks/<file>.mrpack

# Pin a published version (empty = latest).
MODRINTH_VERSION=

# JVM heap.
MEMORY=4G

# Comma-separated files from the pack to leave out on the server.
MODRINTH_EXCLUDE_FILES=

# Account system the server verifies players against. Empty = Mojang/Microsoft accounts (default).
# `ely.by` = Ely.by accounts; any authlib-injector (Yggdrasil) API URL also works.
# Only accounts of that auth server can join. See docs/guides/local-server-docker.md.
# AUTH_SERVER=

# playit.gg agent secret (playit.gg dashboard > Agents). Networking: the agent shares the compose
# network with the server, so set the tunnel's local address to `minecraft:25565` in the dashboard.
PLAYIT_SECRET_KEY=
