# Generated on launch by the game, KubeJS and ProbeJS: per-player, machine-specific or secret
/command_history.txt
/coremods/
# holds the auth token of KubeJS's local web server
/kubejs/config/web_server.json
/kubejs/package.json
/.github/agents/kubejs-*.agent.md
/config/sodium-options.json
/config/sodium-fingerprint.json
/config/sodium-extra-options.json
/config/spark/tmp-client/
# Crash Assistant examples, regenerated when missing
/config/crash_assistant/scripts/log_analysis/example.jexl
/config/crash_assistant/scripts/startup/example.jexl
/config/crash_assistant/crash_assistant_localization_overrides/README.md

# ProbeJS
/kubejs/probe/
/kubejs/config/probejs.json
/kubejs/config/probe-settings.json
/kubejs/*/jsconfig.json

# Client configs (with exceptions below)
/config/**/*client.*

!/config/sophisticatedstorage-client.toml
!/config/**/darkmodeeverywhere-client.toml
!/config/create-client.toml

